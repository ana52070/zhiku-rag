# ==========================================
# Python 文档解析与本地 OCR 微服务 (Worker)
# ==========================================
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /srv

# 安装 Tesseract OCR (含中英语言包) 与 Office/PDF 辅助工具
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-chi-sim \
    tesseract-ocr-eng \
    libtesseract-dev \
    libreoffice-writer \
    fonts-noto-cjk \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖清单并利用腾讯云/阿里云源安装 Python 依赖
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt -i https://mirrors.cloud.tencent.com/pypi/simple

# 拷贝 Worker 业务代码
COPY app/ ./app/

EXPOSE 8002

HEALTHCHECK --interval=20s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://127.0.0.1:8002/health || exit 1

CMD ["python", "-m", "uvicorn", "app.worker:app", "--host", "0.0.0.0", "--port", "8002", "--workers", "2"]
